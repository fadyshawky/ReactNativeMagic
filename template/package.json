{
  "name": "reactnativemagic",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android:prod:debug": "react-native run-android --mode=productionDebug",
    "android:prod:release": "react-native run-android --mode=productionRelease",
    "android:staging:debug": "react-native run-android --mode=stagingDebug",
    "android:staging:release": "react-native run-android --mode=stagingRelease",
    "android:development:debug": "react-native run-android --mode=developmentDebug",
    "android:development:release": "react-native run-android --mode=developmentRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@gorhom/bottom-sheet": "5.2.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "24.0.0",
    "@react-native-firebase/app": "24.0.0",
    "@react-native-firebase/messaging": "24.0.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.15.9",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.11",
    "@reduxjs/toolkit": "2.11.2",
    "@shopify/flash-list": "2.3.1",
    "axios": "^1.18.1",
    "babel-plugin-transform-remove-console": "6.9.4",
    "dayjs": "1.11.20",
    "intl": "1.2.5",
    "lodash": "^4.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.2",
    "react-native-actions-sheet": "10.1.2",
    "react-native-config": "1.6.1",
    "react-native-device-info": "15.0.2",
    "react-native-gesture-handler": "2.31.1",
    "react-native-haptic-feedback": "2.3.3",
    "react-native-keyboard-aware-scroll-view": "0.9.5",
    "react-native-linear-gradient": "2.8.3",
    "react-native-localization": "2.3.2",
    "react-native-permissions": "5.5.1",
    "react-native-reanimated": "4.3.0",
    "react-native-restart": "0.0.27",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.24.0",
    "react-native-sfsymbols": "1.2.2",
    "react-native-size-matters": "0.4.2",
    "react-native-snackbar": "3.0.1",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "10.3.0",
    "react-native-worklets": "0.7.4",
    "react-redux": "9.2.0",
    "redux": "5.0.1",
    "redux-persist": "6.0.0",
    "redux-persist-transform-filter": "0.0.22"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "7.29.2",
    "@babel/runtime": "7.28.6",
    "@react-native-community/cli": "20.1.2",
    "@react-native-community/cli-platform-android": "20.1.2",
    "@react-native-community/cli-platform-ios": "20.1.2",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "husky": "9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "16.4.0",
    "patch-package": "8.0.1",
    "prettier": "3.8.1",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "jest-mock": "^30.0.0",
    "jest-runtime": "^30.0.0",
    "jest-snapshot": "^30.0.0",
    "jest-environment-node": "^30.0.0"
  }
}
