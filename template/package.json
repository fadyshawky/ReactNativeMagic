{
  "name": "reactnativemagic",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android:prod:debug": "react-native run-android --mode=productionDebug",
    "android:prod:release": "react-native run-android --mode=productionRelease",
    "android:staging:debug": "react-native run-android --mode=stagingDebug",
    "android:staging:release": "react-native run-android --mode=stagingRelease",
    "android:development:debug": "react-native run-android --mode=developmentDebug",
    "android:development:release": "react-native run-android --mode=developmentRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.19.1",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.1",
    "@reduxjs/toolkit": "2.12.0",
    "@shopify/flash-list": "2.3.2",
    "axios": "^1.20.0",
    "babel-plugin-transform-remove-console": "6.9.4",
    "dayjs": "1.11.23",
    "intl": "1.2.5",
    "lodash": "^4.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-actions-sheet": "10.1.2",
    "react-native-config": "1.7.2",
    "react-native-device-info": "15.0.2",
    "react-native-gesture-handler": "3.3.0",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-keyboard-aware-scroll-view": "0.9.5",
    "react-native-localization": "2.3.2",
    "react-native-permissions": "5.6.2",
    "react-native-reanimated": "4.6.0",
    "react-native-restart": "0.0.29",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-size-matters": "0.4.2",
    "react-native-snackbar": "3.0.1",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.12.2",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "redux-persist": "6.0.0",
    "redux-persist-transform-filter": "0.0.22"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "lint-staged": "16.4.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.7",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "overrides": {
    "jest-mock": "^30.0.0",
    "jest-runtime": "^30.0.0",
    "jest-snapshot": "^30.0.0",
    "jest-environment-node": "^30.0.0"
  }
}
